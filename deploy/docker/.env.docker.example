# ============================================================
# 同舟喵济 - Docker 部署环境变量
# 复制为 .env 后修改实际值
#   copy .env.docker.example .env
# ============================================================

# ===== MySQL 配置 =====
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=tongzhou_meow
MYSQL_USER=appuser
MYSQL_PASSWORD=change-this-app-password
MYSQL_PORT=3306

# ===== 后端配置 =====
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
# Access Token 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh Token 有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 一体化服务端口（前端 + API + WebSocket） =====
WEB_PORT=8000
