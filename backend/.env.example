# ========== 同舟喵济 后端配置 ==========
# 复制本文件为 .env 并填入实际值

# 应用
APP_NAME=同舟喵济
APP_VERSION=1.0.0

# MySQL 8.x 异步驱动（aiomysql）
DATABASE_URL=mysql+aiomysql://root:123456@127.0.0.1:3306/tongzhou_meow?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS（开发环境）
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# 前端配置/资源目录
FRONTEND_CONFIG_DIR=../frontend/src/game/config
CHARACTERS_ASSET_DIR=../frontend/public/assets/characters

# SMTP 邮件服务（C.1，仅用于密码重置）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=同舟喵济
SMTP_USE_TLS=true
SMTP_VERIFY_CODE_TTL_MINUTES=15
SMTP_VERIFY_CODE_LENGTH=6
