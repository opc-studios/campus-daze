{
  "name": "campus-daze-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "学术喵的奇幻之旅 - Vue 3 + Phaser 3 前端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
